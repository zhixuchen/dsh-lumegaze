{
  "name": "dsh-lumegaze",
  "version": "0.1.0",
  "description": "观灵域行者 AI 网关，需配套观灵域 Tauri 客户端使用",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dsh.bundle.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "node scripts/verify-config.mjs && node scripts/disposer-check.mjs && node scripts/ws-gateway-check.mjs"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5",
    "node": ">=20"
  },
  "icon": "icon.svg",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-plugin-manager": "0.2.1-rc.5",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-plugin-manager": "0.2.1-rc.5",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh.bundle.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale",
        "configForms"
      ]
    }
  }
}
